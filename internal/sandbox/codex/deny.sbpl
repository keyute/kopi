; Modified by the Kopi authors: extracted the rules from Rust string literals and wrote the XPC comment.

; XPC services run outside this sandbox.
(deny mach-lookup (xpc-service-name-prefix ""))
; These fcntls mutate files through read-only descriptors, bypassing file-write*
; and file-ioctl. F_MAKECOMPRESSED = 80, F_TRANSFEREXTENTS = 110.
(deny system-fcntl (fcntl-command 80 110))
